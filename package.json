{
  "name": "clip360-web",
  "version": "0.3.0",
  "description": "Clip360 creator app for Thai AI voiceover and karaoke captions",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "local": "node server/index.mjs",
    "local:mock": "cross-env CLIP360_MOCK_TTS=1 node server/index.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:local": "node --test tests/store.test.mjs tests/local-setup-security.test.mjs tests/whisper-align.test.mjs tests/narration-fit.test.mjs tests/narration-pace.test.mjs tests/narration-length.test.mjs tests/voice-clones.test.mjs tests/server-api-or-queue.test.mjs pipeline/tests/unit.test.mjs && node pipeline/tests/mock-render.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/kanit": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "hyperframes": "0.7.106",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
